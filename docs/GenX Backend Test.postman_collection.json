{
  "info": {
    "name": "GenX Backend Test 2026",
    "description": "Hai API đã triển khai trong bài test backend. Chạy npm run dev trước khi gửi request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Generate schedule",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startDate\": \"2026-01-01\",\n  \"totalClasses\": 16,\n  \"classWeekdays\": [1, 3],\n  \"holidays\": [\"2026-04-30\", \"2026-05-01\"],\n  \"holidayRanges\": [[\"2026-01-26\", \"2026-02-05\"]]\n}"
        },
        "url": "{{baseUrl}}/schedule/generate"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('16 sessions ending 2026-03-10', () => {",
            "  const result = pm.response.json();",
            "  pm.expect(result.fullSchedule).to.have.lengthOf(16);",
            "  pm.expect(result.endDate).to.equal('2026-03-10');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Calculate invoice",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courseType\": \"MONTHLY\",\n  \"basePrice\": 1500000,\n  \"months\": 2,\n  \"promoCode\": \"SAVE10\",\n  \"canceledClasses\": 1,\n  \"refundPerClass\": 40000\n}"
        },
        "url": "{{baseUrl}}/invoice/calc"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('total is 2660000', () => {",
            "  pm.expect(pm.response.json().total).to.equal(2660000);",
            "});"
          ]
        }
      }]
    }
  ]
}
